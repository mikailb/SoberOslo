# Sanity — these are public values, not secrets.
# Find them at https://sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# The address the site runs on in production. Used for canonical links,
# the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://soberoslo.no

# --- ChatGPT connection (/api/mcp) ------------------------------------------
# SECRETS. Put them only in .env.local and in Vercel's environment variables.
# Never give them a NEXT_PUBLIC_ prefix and never commit real values.

# Sanity robot token with the Editor role (not Administrator).
# sanity.io/manage -> your project -> API -> Tokens -> Add API token.
SANITY_WRITE_TOKEN=

# The board's password for connecting ChatGPT. At least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every connected ChatGPT out.
MCP_ACCESS_TOKEN=

# Optional. Public address of the site, if a proxy hides the real host.
# MCP_PUBLIC_URL=https://soberoslo.no
# Optional. Extra exact OAuth redirect addresses, comma separated.
# MCP_OAUTH_EXTRA_REDIRECT_URIS=
